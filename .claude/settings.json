{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git fetch*)",
      "Bash(git worktree list*)",
      "Bash(git worktree add*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh issue create*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue reopen*)",
      "Bash(gh label list*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(bun run dev*)",
      "Bash(bun run build*)",
      "Bash(bun run lint*)",
      "Bash(bun run test*)",
      "Bash(bun run e2e*)",
      "Bash(bun run format*)",
      "Bash(bun install*)",
      "Bash(bunx tsc*)",
      "Bash(bun x --package @playwright/cli*)",
      "Bash(.tmp/pwcli*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run alembic*)",
      "Bash(uv sync*)",
      "Bash(uv add*)",
      "Read",
      "Edit(.tmp/**)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git worktree remove*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)"
    ],
    "deny": [
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(npm install*)",
      "Bash(npx *)",
      "Bash(pip install*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Edit(**/routeTree.gen.ts)",
      "Edit(**/schema.gen.ts)"
    ]
  }
}
