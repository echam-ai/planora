prefix_rule(
    pattern = [["python", "python3"], "-m", ["pip", "pip3"]],
    decision = "forbidden",
    justification = "Use uv for API dependencies, not pip module invocation.",
    match = ["python -m pip install example", "python3 -m pip3 install example"],
    not_match = ["uv run python -m planora_api.openapi"],
)

prefix_rule(
    pattern = ["rtk", ["python", "python3"], "-m", ["pip", "pip3"]],
