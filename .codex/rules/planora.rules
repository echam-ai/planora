# Trusted project-local policy. See docs/PROCESS.md for startup and prefix limits.

prefix_rule(
    pattern = ["gh", "pr", ["create", "merge"]],
    decision = "forbidden",
    justification = "Use the local reviewed issue pipeline; no pull requests.",
    match = ["gh pr create", "gh pr merge 1"],
    not_match = ["gh pr view 1"],
)

prefix_rule(
    pattern = [["npm", "npx", "pip", "pip3"]],
    decision = "forbidden",
    justification = "Use bun/bunx for web or uv for API.",
    match = ["npm install", "npx install", "pip install", "pip3 install"],
    not_match = ["bun install", "uv sync"],
)

prefix_rule(
    pattern = ["git", "stash"],
    decision = "forbidden",
    justification = "Preserve worktree state; compare against the base in the main checkout.",
    match = ["git stash", "git stash push"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Preserve user edits; report conflicts instead of destructive reset.",
    match = ["git reset --hard HEAD"],
    not_match = ["git reset --soft HEAD"],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Only the orchestrator pushes reviewed work; require command approval rather than inheriting a broad allow.",
    match = ["git push origin main"],
    not_match = ["git status", "git -C checkout push origin main"],
)

prefix_rule(
    pattern = ["git", "push", ["--force", "--force-with-lease", "-f"]],
    decision = "forbidden",
    justification = "No agent force-pushes; history rewrite requires the separate human procedure.",
    match = ["git push --force", "git push --force-with-lease", "git push -f"],
    not_match = ["git push origin main", "git push origin main --tags --force"],
)

prefix_rule(
    pattern = ["git", "push", "origin", ["--force", "--force-with-lease", "-f"]],
    decision = "forbidden",
    justification = "No agent force-pushes; history rewrite requires the separate human procedure.",
    match = ["git push origin --force", "git push origin --force-with-lease", "git push origin -f"],
    not_match = ["git push origin main", "git push origin main --tags --force"],
)

prefix_rule(
    pattern = ["git", "push", "origin", "main", ["--force", "--force-with-lease", "-f"]],
    decision = "forbidden",
    justification = "No agent force-pushes; history rewrite requires the separate human procedure.",
    match = ["git push origin main --force", "git push origin main --force-with-lease", "git push origin main -f"],
    not_match = ["git push origin main", "git push origin main --tags --force"],
)

prefix_rule(
    pattern = ["rtk", "gh", "pr", ["create", "merge"]],
    decision = "forbidden",
    justification = "Use the local reviewed issue pipeline; no pull requests.",
    match = ["rtk gh pr create", "rtk gh pr merge 1"],
    not_match = ["rtk gh pr view 1"],
)

