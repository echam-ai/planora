# Copy to a private env file, then fill ALL values. Never commit live secrets.
CADDY_BIND_ADDRESS=127.0.0.1
CADDY_HTTP_PORT=18080
APP_ORIGIN=http://127.0.0.1:18080
# Production uses compose.production.yml as well as compose.yml, public TCP
# 80/443, CADDY_BIND_ADDRESS=0.0.0.0, and APP_ORIGIN=https://your-domain.
# PLANORA_DOMAIN must be a public FQDN without scheme, port, path or wildcard.
# Leave empty for setup HTTP; production overlay rejects an empty domain.
PLANORA_DOMAIN=
# Pick a subnet unused by the host, VPN, and other Compose projects.
PROXY_SUBNET=172.30.43.0/24
# Dynamic allocations must exclude the fixed trusted Caddy address.
PROXY_DYNAMIC_RANGE=172.30.43.128/25
CADDY_IP=172.30.43.2
IMAGE_TAG=local
POSTGRES_DB=planora
POSTGRES_USER=planora
POSTGRES_PASSWORD=
# URL-encode the password component and use the same DB/user/password above.
DATABASE_URL=
SESSION_SECRET=
LLM_API_KEY=
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_MODEL=kimi-k3
DEFAULT_TIMEZONE=Asia/Singapore
