# Copy this file to `.env` and fill in real values before starting the API.
# `.env` itself is git-ignored; never commit real secrets.

# Database connection string. Default: a local SQLite file for development;
# production points this at PostgreSQL instead.
DATABASE_URL=sqlite:///./planora.db

# Secret key used to sign session cookies. Required, no default — startup
# fails if this is left blank. Generate a long random value, e.g.
# `openssl rand -hex 32`.
SESSION_SECRET=

# Base URL of the OpenAI-compatible LLM endpoint. Default: Moonshot AI.
LLM_BASE_URL=https://api.moonshot.ai/v1

# API key for the LLM endpoint. Required, no default — startup fails if this
# is left blank. Never returned to the browser or logged.
LLM_API_KEY=

# Model name requested from the LLM endpoint. Default: kimi-k3.
LLM_MODEL=kimi-k3

# The application's public origin: scheme + host [+ port], no path. Required,
# no default — startup fails if this is left blank. Every state-changing
# (non-GET/HEAD/OPTIONS) request's Origin header must match this exactly
# (issue #26) — set it to exactly the origin your browser shows, never a
# guess:
#   - Local development: the web dev server's printed Local URL, normally
#     http://localhost:5173 (Vite's default port).
#   - Production: the public https:// origin the browser actually loads,
#     e.g. https://planora.example.
# `localhost` and `127.0.0.1` are different origins to a browser — use
# whichever one you actually type into the address bar, not the other.
APP_ORIGIN=

# IANA timezone used for deadline display and input interpretation.
# Default: Asia/Singapore.
DEFAULT_TIMEZONE=Asia/Singapore
