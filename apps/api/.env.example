# Copy this file to `.env`. With scripts/run-local.sh, fill in only LLM_API_KEY.
# `.env` itself is git-ignored; never commit real secrets.

# Database connection string. Default: a local SQLite file for development;
# production points this at PostgreSQL instead.
DATABASE_URL=sqlite:///./planora.db

# Base URL of the OpenAI-compatible LLM endpoint. Default: Moonshot AI.
LLM_BASE_URL=https://api.moonshot.ai/v1

# API key for the LLM endpoint. Required, no default — startup fails if this
# is left blank, including in the local launcher. A placeholder permits local
# non-AI features. Never returned to the browser or logged.
LLM_API_KEY=

# Model name requested from the LLM endpoint. Default: kimi-k3.
LLM_MODEL=kimi-k3

# Optional comma-separated extra model names the user may pick in Settings
# (issue #86). Entries are trimmed; empty entries are ignored. The offered
# list is LLM_MODEL first, then these in order, without duplicates. Leave
# blank to offer only LLM_MODEL. Only list models the endpoint serves.
LLM_ALLOWED_MODELS=

# The application's public origin: scheme + host [+ port], no path.
# scripts/run-local.sh defaults a blank value to http://localhost:5173; an
# override must use http://localhost:<port> or http://127.0.0.1:<port> (1–65535).
# Direct API/scheduler and deployment require an explicit nonblank value.
# Every state-changing
# (non-GET/HEAD/OPTIONS) request's Origin header must match this exactly
# (issue #26) — set it to exactly the origin your browser shows, never a
# guess:
#   - Local development: the web dev server's printed Local URL, normally
#     http://localhost:5173 (Vite's default port).
#   - Production: the public https:// origin the browser actually loads,
#     e.g. https://planora.example.
# `localhost` and `127.0.0.1` are different origins to a browser — use
# whichever one you actually type into the address bar, not the other.
APP_ORIGIN=

# No credentials or account setup: choose Hamster Knight or Ech Princess on `/`.
# Profile choice separates data; it is not an identity/access-control boundary.

# IANA timezone used for deadline display and input interpretation.
# Default: Asia/Singapore.
DEFAULT_TIMEZONE=Asia/Singapore

# This is the only .env template the local launcher (scripts/run-local.sh,
# issue #93) reads. It sets the web tier's VITE_API_MODE and
# PLANORA_API_PROXY_TARGET itself, derived from APP_ORIGIN above and the
# API address it starts — never from apps/web/.env — so those two values
# can never drift from the API actually running. See README.md, "Run
# locally on macOS".
