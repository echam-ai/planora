{
  "components": {
    "schemas": {
      "ArchiveListResponse": {
        "additionalProperties": false,
        "description": "The full-page shape for `GET /api/v1/archive`.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TaskResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ],
        "title": "ArchiveListResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationErrorDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "ParseTaskRequest": {
        "additionalProperties": false,
        "description": "`POST /api/v1/ai/parse-task` request body. `text` is required to be\n1 to 4000 characters *after* trimming; the trimmed value is what the\nrouter and the model both see — an over-length, empty, whitespace-only,\nmissing or non-string `text` is rejected here, before the model is\never called.",
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "ParseTaskRequest",
        "type": "object"
      },
      "ParsedTaskResponse": {
        "additionalProperties": false,
        "description": "The `TaskDraft` wire shape (spec §6.2) — exactly what a confirmed\npreview later posts, unchanged, to `POST /api/v1/tasks`\n(`schemas.task.TaskCreate` minus `status`). No `id`, no `status`, and\nno server timestamp: this is a proposal, not a persisted task (spec\n§6.2: \"The LLM may only propose values. It does not save a task\ndirectly\").",
        "properties": {
          "category": {
            "$ref": "#/components/schemas/TaskCategory"
          },
          "content": {
            "title": "Content",
            "type": "string"
          },
          "deadline_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline At"
          },
          "markdown_note": {
            "default": "",
            "title": "Markdown Note",
            "type": "string"
          },
          "priority": {
            "$ref": "#/components/schemas/TaskPriority"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "urls": {
            "items": {
              "$ref": "#/components/schemas/TaskUrl"
            },
            "title": "Urls",
            "type": "array"
          }
        },
        "required": [
          "title",
          "content",
          "category",
          "priority"
        ],
        "title": "ParsedTaskResponse",
        "type": "object"
      },
      "PasswordChangeRequest": {
        "additionalProperties": false,
        "description": "`POST /api/v1/settings/password` request body (spec §3.2).\n\nPasswords are compared and hashed verbatim — never trimmed. Only\n`new_password`'s length is checked here (before any database or Argon2\nwork); `current_password` is validated by the router, against the\nstored hash, so an invalid `new_password` never costs an Argon2\nverification. The length rule itself is `security.password`'s shared\ndefinition (issue #33 moved it there so #33's administrative reset\ncommand can reuse it without a second copy of the rule).",
        "properties": {
          "current_password": {
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "PasswordChangeRequest",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "signed_in_at": {
            "title": "Signed In At",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "signed_in_at"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SettingsResponse": {
        "additionalProperties": false,
        "description": "The full settings wire shape — exactly `timezone` and `model_name`,\nnothing else; never a secret (spec §11).",
        "properties": {
          "model_name": {
            "title": "Model Name",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "timezone",
          "model_name"
        ],
        "title": "SettingsResponse",
        "type": "object"
      },
      "SettingsUpdate": {
        "additionalProperties": false,
        "description": "`PATCH /api/v1/settings` request body — a partial update.\n\nBoth fields default to `None`, meaning \"left out of the body\"; the\nrouter distinguishes that from an explicit value via\n`model_dump(exclude_unset=True)` (pydantic does not run a field\nvalidator against a default that was never supplied — only against a\nvalue actually present in the request). An explicit `null` for either\nfield is therefore *not* a valid way to clear an override back to the\ndeployment default — this schema rejects it outright, matching the\nacceptance criteria.\n\nExtra fields (`llm_api_key`, `llm_base_url`, `database_url`,\n`session_secret`, `password`, ...) are rejected outright: secrets and\ndatabase configuration are never editable through the browser\n(spec §11).",
        "properties": {
          "model_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Name"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone"
          }
        },
        "title": "SettingsUpdate",
        "type": "object"
      },
      "TaskCategory": {
        "enum": [
          "work",
          "personal",
          "study",
          "other"
        ],
        "title": "TaskCategory",
        "type": "string"
      },
      "TaskCreate": {
        "additionalProperties": false,
        "description": "`POST /api/v1/tasks` request body (spec §6.1 defaults).\n\nExtra fields are rejected outright — both truly unknown keys and every\nserver-owned field (`id`, `position`, `created_at`, `updated_at`,\n`completed_at`, `archived_at`), none of which this model declares, so\nthey can never be silently dropped or, worse, silently honored.",
        "properties": {
          "category": {
            "$ref": "#/components/schemas/TaskCategory",
            "default": "other"
          },
          "content": {
            "title": "Content",
            "type": "string"
          },
          "deadline_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline At"
          },
          "markdown_note": {
            "default": "",
            "title": "Markdown Note",
            "type": "string"
          },
          "priority": {
            "$ref": "#/components/schemas/TaskPriority",
            "default": "medium"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus",
            "default": "todo"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "urls": {
            "items": {
              "$ref": "#/components/schemas/TaskUrl"
            },
            "title": "Urls",
            "type": "array"
          }
        },
        "required": [
          "title",
          "content"
        ],
        "title": "TaskCreate",
        "type": "object"
      },
      "TaskMove": {
        "additionalProperties": false,
        "description": "`POST /api/v1/tasks/{task_id}/move` request body (issue #29).\n\n`index` is an insertion index, not a stored `position` value — for a\nmove into another column it is the index among that column's existing\ntasks (`0` to `len(target)` inclusive); for a move whose `status`\nequals the task's current one it is the task's final index in its own\ncolumn (`0` to `len(column) - 1` inclusive). Both bounds depend on the\ntarget column's size at request time, so only the lower bound (never\nnegative) is enforced by the wire type here — the upper bound is\nchecked by `domain/ordering.py` and turned into a `422` by the router;\nneither bound is ever clamped.",
        "properties": {
          "index": {
            "minimum": 0.0,
            "title": "Index",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          }
        },
        "required": [
          "status",
          "index"
        ],
        "title": "TaskMove",
        "type": "object"
      },
      "TaskPriority": {
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "TaskPriority",
        "type": "string"
      },
      "TaskReorder": {
        "additionalProperties": false,
        "description": "`POST /api/v1/tasks/reorder` request body (issue #29).\n\n`ordered_ids` must be an exact permutation of the ids of the active\ntasks currently in `status` — checked by `domain/ordering.reorder_column`\nand turned into a `422` by the router for a duplicate, an omission, or\na foreign/archived/unknown id.",
        "properties": {
          "ordered_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Ordered Ids",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          }
        },
        "required": [
          "status",
          "ordered_ids"
        ],
        "title": "TaskReorder",
        "type": "object"
      },
      "TaskResponse": {
        "additionalProperties": false,
        "description": "The full task wire shape — exactly the 14 §5 fields, nothing else.",
        "properties": {
          "archived_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archived At"
          },
          "category": {
            "$ref": "#/components/schemas/TaskCategory"
          },
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "content": {
            "title": "Content",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "deadline_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "markdown_note": {
            "title": "Markdown Note",
            "type": "string"
          },
          "position": {
            "title": "Position",
            "type": "number"
          },
          "priority": {
            "$ref": "#/components/schemas/TaskPriority"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "urls": {
            "items": {
              "$ref": "#/components/schemas/TaskUrl"
            },
            "title": "Urls",
            "type": "array"
          }
        },
        "required": [
          "id",
          "title",
          "content",
          "status",
          "category",
          "priority",
          "deadline_at",
          "urls",
          "markdown_note",
          "position",
          "created_at",
          "updated_at",
          "completed_at",
          "archived_at"
        ],
        "title": "TaskResponse",
        "type": "object"
      },
      "TaskStatus": {
        "enum": [
          "todo",
          "in_progress",
          "done"
        ],
        "title": "TaskStatus",
        "type": "string"
      },
      "TaskUpdate": {
        "additionalProperties": false,
        "description": "`PATCH /api/v1/tasks/{id}` request body — a partial update.\n\nEvery field defaults to `None`, meaning \"left out of the body\" — the\nrouter distinguishes that from an *explicit* `null` via\n`model_dump(exclude_unset=True)`, since pydantic does not run a field's\nvalidators against a default value that was never supplied (only\nagainst a value actually present in the request, including an explicit\n`null`). An explicit `null` for a field the database stores `NOT NULL`\n(`title`, `content`, `markdown_note`, `category`, `priority`, `status`,\n`urls`) is rejected by the validators below; only `deadline_at` accepts\nan explicit `null`, which clears the deadline.",
        "properties": {
          "category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TaskCategory"
              },
              {
                "type": "null"
              }
            ]
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          },
          "deadline_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline At"
          },
          "markdown_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Markdown Note"
          },
          "priority": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TaskPriority"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TaskStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "urls": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/TaskUrl"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Urls"
          }
        },
        "title": "TaskUpdate",
        "type": "object"
      },
      "TaskUrl": {
        "additionalProperties": false,
        "description": "One URL entry (spec §5, §8). No `id` on the wire — the web tier's\nHTTP mapper assigns a client-side id for its own `TaskUrl.id` (the\nuser's non-scope decision recorded on issue #28: URL entries stay\nid-less on the wire).",
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "TaskUrl",
        "type": "object"
      },
      "ValidationErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "ValidationErrorDetail",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Planora API",
    "version": "0.1.0"
