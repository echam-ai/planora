# Only production source, migration files, and locked build inputs enter context.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!.python-version
!src/
!src/**
!alembic.ini
!alembic/
!alembic/**

# Apply these again after source allowlists to exclude nested local residue.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*.sqlite3-*
**/__pycache__
**/*.py[cod]
**/.venv
**/node_modules
**/.tmp
**/.cache
**/.pytest_cache
**/.ruff_cache
**/.coverage*
**/coverage*
**/htmlcov
**/dist
**/build
**/.output
**/test-results
**/playwright-report
