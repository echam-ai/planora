# Selects the ApiClient implementation at build time (src/services/api/index.ts).
#   http — the real FastAPI backend.
#   mock — sample data kept in browser storage. Default when unset.
# Any other value, including wrong case ("HTTP"), fails `vite build` and
# `vite dev` immediately (validated in vite.config.ts via
# src/services/api/apiMode.ts), naming this variable and its allowed values.
# Production builds (#42/#43) must set this to "http".
VITE_API_MODE=mock

# Dev-server-only proxy target for /api/v1 requests (vite.config.ts). Never
# prefixed with VITE_, so it is read only by Vite's own Node process and
# never reaches the client bundle. Defaults to http://127.0.0.1:8000 when
# unset. Point the API at this dev server's origin via its own APP_ORIGIN
# (e.g. http://localhost:5173) when running HTTP mode locally.
# PLANORA_API_PROXY_TARGET=http://127.0.0.1:8000
